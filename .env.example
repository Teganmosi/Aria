# =============================================================================
# Aria backend — environment configuration template
# Copy to .env and fill in real values. NEVER commit your .env file.
# =============================================================================

# ---- AI providers ----
OPENAI_API_KEY=
NVIDIA_API_KEY=
API_BIBLE_KEY=
YARNGPT_API_KEY=
# GCP Text-to-Speech (optional): path to a credentials file OR inline JSON string
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_JSON=

# ---- Supabase (authentication) ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/aria
# Keep pool sizes modest — Supabase free tier allows ~20 concurrent connections
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---- Redis (optional caching) ----
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ---- Application ----
DEBUG=false
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start if this is left as a known placeholder value.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ---- CORS ----
# JSON array of allowed frontend origins. Never use ["*"] with credentials in production.
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ---- Error tracking (optional) ----
# Leave unset to disable. Get a DSN at sentry.io → Projects → your project → Settings.
SENTRY_DSN=

# ---- Premium voice tier ----
# Google Gemini Live API (AI Studio → Get API key). Powers the premium call engine.
GEMINI_API_KEY=
# Alibaba DashScope (Qwen-Omni Realtime) — alternative premium engine.
DASHSCOPE_API_KEY=
# Which premium engine to use: "gemini" or "qwen"
PREMIUM_VOICE_ENGINE=gemini

# ---- Payments (Paystack) ----
# Dashboard → Settings → API Keys. Use sk_test_... while developing, sk_live_... in prod.
PAYSTACK_SECRET_KEY=
# Public URL of this backend (Paystack checkout redirects + webhooks land here),
# e.g. https://aria-backend-kjqw.onrender.com
PUBLIC_BACKEND_URL=http://localhost:8002
# Public URL of the frontend (where users land after checkout), e.g. https://aria-frontend-fjpa.onrender.com
FRONTEND_URL=http://localhost:5173
